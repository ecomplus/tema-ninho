---
import type { CmsFields, InferCmsOutput } from '@@sf/content';
import { bannerListCmsField } from '@@sf/composables/use-banner';
import Picture from '@@sf/components/Picture.astro';

/*
 * Grade de banners — variante Ninho (bebê e infantil).
 *
 * NÃO usa o `Banner.vue` do starter. Com `title`/`subtitle` preenchidos ele
 * vira um grid de duas colunas com `p-12 xl:ps-32`, dimensionado para largura
 * total. Numa coluna de 1/3 o texto quebra UMA PALAVRA POR LINHA e a imagem
 * some — apareceu no primeiro print desta loja e é o mesmo defeito que a
 * Bitola já tinha documentado.
 *
 * Idioma do tema: raio grande, sombra suave, legenda numa pastilha branca
 * FLUTUANDO sobre a foto. Sem gradiente escuro por cima — foto de enxoval é
 * clara e um véu preto a suja. A pastilha resolve a legibilidade sem escurecer.
 */
export const cmsFields = ({
  banners: { required: true, ...bannerListCmsField },
}) as const satisfies CmsFields;

export type Props = InferCmsOutput<typeof cmsFields>;
const { banners = [] } = Astro.props;
---

<section class="ui-section">
  <ul class="grid grid-cols-1 gap-5 sm:grid-cols-3">
    {banners.map((banner) => (
      <li>
        <a
          href={banner.href || '#'}
          class="group relative block overflow-hidden rounded-3xl bg-white
          shadow-sm transition hover:shadow-md"
        >
          <Picture
            src={banner.img}
            alt={banner.alt || ''}
            widths={[400, 640, 828]}
            sizes="(min-width: 640px) 33vw, 100vw"
            loading="lazy"
            class="aspect-[4/3] w-full object-cover transition-transform
            duration-500 md:group-hover:scale-105"
          />
          {(banner.title || banner.subtitle) && (
            <div
              class="absolute inset-x-3 bottom-3 rounded-2xl bg-white/95 px-4 py-3
              backdrop-blur-sm"
            >
              {banner.title && (
                <h3 class="font-brand text-lg font-bold leading-tight
                  text-base-900 transition-colors group-hover:text-primary">
                  {banner.title}
                </h3>
              )}
              {banner.subtitle && (
                <p class="mt-0.5 text-xs leading-snug text-base-600">
                  {banner.subtitle}
                </p>
              )}
            </div>
          )}
        </a>
      </li>
    ))}
  </ul>
</section>
